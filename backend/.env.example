# Copy to .env and fill in before running the dev tools.
# Real secrets never belong in this file.

# Local Medusa backend basics (see also .env values used by docker-compose).
STORE_CORS=http://localhost:3030
ADMIN_CORS=http://localhost:9030
AUTH_CORS=http://localhost:3030,http://localhost:9030

# LORENCESS dev seed (src/scripts/lorencess-dev-seed.ts). Required together;
# the password must be at least 12 characters and the seed refuses to run
# when NODE_ENV=production. The password is never written to logs.
LORENCESS_SEED_ADMIN_EMAIL=
LORENCESS_SEED_ADMIN_PASSWORD=
