STORE_CORS=http://localhost:3030
ADMIN_CORS=http://localhost:9030,http://localhost:7001
AUTH_CORS=http://localhost:3030,http://localhost:9030,http://localhost:7001
# Production validation (strong secrets, S3 storage, Redis, HTTPS CORS) runs
# unless NODE_ENV is explicitly "development" or "test". Deployments MUST set
# NODE_ENV=production; a missing or misspelled value fails closed and refuses
# to start with weak configuration.
# With REDIS_URL set, the event bus and workflow engine also run on Redis
# (persistent events, retries, multi-instance safe). Without it they stay in-memory.
REDIS_URL=redis://localhost:6480
JWT_SECRET=replace_with_secure_random_hex
COOKIE_SECRET=replace_with_secure_random_hex
DATABASE_URL=postgres://cansoria:cansoria@localhost:5433/cansoria_medusa_v2
DB_NAME=cansoria_medusa_v2

# Commerce readiness is store data, not env: set store metadata
# { "orders_open": true } in the admin store settings when the studio opens
# orders. Until then completion and new payment sessions are rejected.

# Backend and storefront URLs
MEDUSA_BACKEND_URL=http://localhost:9030
STOREFRONT_URL=http://localhost:3030
FRONTEND_URL=http://localhost:3030

# Resend Email Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@cansoria.com
RESEND_REPLY_TO=hello@cansoria.com
# Studio contact form recipient; leave blank until ready to receive inquiries.
CONTACT_EMAIL=
# Persistent signing key for stored references. Required in production.
# Keep stable independently of JWT_SECRET rotations; use at least 32 random characters.
PORTRAIT_PHOTO_SECRET=

# Stripe Payment Configuration
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Klaviyo
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost
TURNSTILE_ACTION=newsletter

# Only configure direct trusted proxies that replace X-Real-IP and block direct backend access.
TRUSTED_PROXY_IPS=
# Server-only, must match frontend STORE_VISITOR_SECRET (32+ random characters).
# Cookies cannot authenticate direct backend requests; BFF request proofs can.
STORE_VISITOR_SECRET=

# Script targets are explicit; never hard-code customer addresses.
COUPON_TARGET_EMAIL=

# Cloudflare R2 / S3-compatible Storage
S3_FILE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=cansoria-assets
S3_ENDPOINT=
S3_REGION=auto
