NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9030
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_SALES_CHANNEL_ID=
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3030
MEDUSA_BACKEND_URL=http://localhost:9030
MEDUSA_PUBLISHABLE_KEY=
# Enable only when ingress overwrites the header and blocks direct frontend access.
# Backend TRUSTED_PROXY_IPS must contain the BFF's actual outbound IP.
STORE_TRUSTED_IP_HEADER=
STORE_TRUSTED_PROXY_HOPS=1

# Comma-separated public asset origins. Add your production CDN hostname explicitly.
NEXT_PUBLIC_ASSET_ORIGINS=https://images.unsplash.com,https://videos.pexels.com
# Chat fails closed in production when Redis is missing or unavailable.
CHAT_REDIS_URL=
CHAT_DAILY_CALL_BUDGET=500
# Set only if ingress overwrites this header and blocks direct origin access.
# Supported: x-forwarded-for, x-real-ip, cf-connecting-ip. Empty shares one safe bucket.
CHAT_TRUSTED_IP_HEADER=
# Count trusted proxy hops from the right of x-forwarded-for (1 for one ingress).
CHAT_TRUSTED_PROXY_HOPS=1
GEMINI_API_KEY=
