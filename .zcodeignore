**/tsc_widget_errors.txt

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Credentials
**/keys.json
**/*.pem
**/*.key

# Additional local environment and editor files
**/.env.*
!**/.env.example
!**/.env.template
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db

